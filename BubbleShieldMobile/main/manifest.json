{
  "manifest_version": 3,
  "name": "Bubble Shield",
  "version": "1.0.0",
  "description": "Filter tweets based on keywords or author's profile bio. All processing happens locally.",
  "icons": {
    "16": "BubbleShield16.png",
    "48": "BubbleShield48.png",
    "128": "BubbleShield128.png"
  },
  "action": {
    "default_icon": {
      "16": "BubbleShield16.png",
      "48": "BubbleShield48.png",
      "128": "BubbleShield128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "BubbleShield16.png",
        "BubbleShield48.png",
        "BubbleShield128.png"
      ],
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ]
    }
  ],
  "author": "Bubble Shield Team"
}